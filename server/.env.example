# Postgres connection string from your Neon project (Dashboard > Connection Details).
# Use the "pooled connection" string — it has -pooler in the hostname.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# From resend.com > API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where contact form notifications get sent — your real inbox.
CONTACT_EMAIL_TO=james@baroniapplied.co.uk

# Must be a verified sender on your Resend account. Using Resend's shared
# onboarding@resend.dev sandbox address works with zero setup but is less
# deliverable long-term — verify your own domain in Resend when you have one.
CONTACT_EMAIL_FROM=onboarding@resend.dev

# Comma-separated list of origins allowed to call this API (your site's
# real URL(s) — include both the Render URL and any custom domain).
ALLOWED_ORIGINS=https://baroniapplied.co.uk,https://www.baroniapplied.co.uk,http://localhost:8000

PORT=3000
